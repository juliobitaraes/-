rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isGlobalSuperAdmin() {
      return isAuthenticated() && request.auth.uid == 'xSeQ7zitlkdWfYRW0IBbQoCS0yF3';
    }

    function isSchoolMember(schoolId) {
      return isGlobalSuperAdmin() || (
        isAuthenticated() &&
        exists(/databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid))
      );
    }

    function getMemberData(schoolId) {
      return get(/databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid)).data;
    }

    function hasRole(schoolId, role) {
      return isGlobalSuperAdmin() || (
        isSchoolMember(schoolId) &&
        getMemberData(schoolId).tipo == role
      );
    }

    function isAdmin(schoolId) {
      return hasRole(schoolId, 'admin');
    }

    function isProfessor(schoolId) {
      return hasRole(schoolId, 'professor');
    }

    function isSecretaria(schoolId) {
      return hasRole(schoolId, 'secretaria');
    }

    function isAluno(schoolId) {
      return hasRole(schoolId, 'aluno');
    }

    function isAdminOrProfessor(schoolId) {
      return isAdmin(schoolId) || isProfessor(schoolId);
    }

    function isAdminOrProfessorOrSecretaria(schoolId) {
      return isAdmin(schoolId) || isProfessor(schoolId) || isSecretaria(schoolId);
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Verifica se o usuário existe na coleção users da escola (alunos e professores)
    function isSchoolUser(schoolId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/schools/$(schoolId)/users/$(request.auth.uid));
    }

    // Membro da escola: seja via members (admin) ou via users (aluno/professor)
    function isSchoolParticipant(schoolId) {
      return isGlobalSuperAdmin() || isSchoolMember(schoolId) || isSchoolUser(schoolId);
    }

    function isAvisoLeituraOnlyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leituras']);
    }

    function isPublishedPublicAvulsa(schoolId, atividadeId) {
      return exists(/databases/$(database)/documents/schools/$(schoolId)/provas/$(atividadeId))
        && get(/databases/$(database)/documents/schools/$(schoolId)/provas/$(atividadeId)).data.tipo == 'atividade'
        && get(/databases/$(database)/documents/schools/$(schoolId)/provas/$(atividadeId)).data.avulsaPublica == true
        && get(/databases/$(database)/documents/schools/$(schoolId)/provas/$(atividadeId)).data.published == true;
    }

    // Bloqueio total para estrutura raiz legada
    match /users/{docId} {
      allow read, write: if isGlobalSuperAdmin();
    }

    // Dados isolados por escola
    match /schools/{schoolId} {
      allow read: if isSchoolMember(schoolId);
      allow write: if isGlobalSuperAdmin();

      match /members/{memberUid} {
        allow read: if isSchoolMember(schoolId);
        allow create, update, delete: if isAdmin(schoolId) || isGlobalSuperAdmin();
      }

      match /users/{userId} {
        allow read: if isSchoolMember(schoolId);
        allow create: if isAdminOrProfessorOrSecretaria(schoolId);
        allow update: if isOwner(userId) || isAdmin(schoolId);
        allow delete: if isAdmin(schoolId);
      }

      match /fcmTokens/{tokenId} {
        allow read: if isSchoolParticipant(schoolId);
        allow create: if isSchoolParticipant(schoolId) && request.resource.data.userId == request.auth.uid;
        allow update: if isSchoolParticipant(schoolId) && resource.data.userId == request.auth.uid;
        allow delete: if isSchoolParticipant(schoolId) && resource.data.userId == request.auth.uid;
      }

      match /notifications/{notificationId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isAdminOrProfessor(schoolId);
      }

      match /turmas/{turmaId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isAdminOrProfessorOrSecretaria(schoolId);
      }

      match /componentes/{componenteId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isAdminOrProfessorOrSecretaria(schoolId);
      }

      match /materiais/{materialId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isAdminOrProfessor(schoolId);
      }

      match /provas/{provaId} {
        allow read: if isSchoolMember(schoolId)
          || (
            resource.data.tipo == 'atividade'
            && resource.data.avulsaPublica == true
            && resource.data.published == true
          );
        allow create, update: if isAdminOrProfessor(schoolId);
        allow delete: if isAdminOrProfessor(schoolId)
          && (
            resource.data.provaRecuperacao == true
            || (
              resource.data.tipo == 'atividade'
              && resource.data.avulsaPublica == true
              && isAdminOrProfessorOrSecretaria(schoolId)
            )
            || (
              resource.data.published != true
              && resource.data.wasPublished != true
              && resource.data.concluida != true
            )
          );
      }

      match /provas_resultados/{resultadoId} {
        allow read: if isSchoolMember(schoolId);
        allow create: if isAluno(schoolId) && request.resource.data.alunoId == request.auth.uid;
        allow update, delete: if isAdminOrProfessor(schoolId);
      }

      match /trabalhos/{trabalhoId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isSchoolMember(schoolId);
      }

      match /trabalhos_notas/{notaId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isAdminOrProfessor(schoolId);
      }

      match /trabalhos_salas/{salaId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isAdminOrProfessor(schoolId);
      }

      match /atividades_salas/{salaId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isAdminOrProfessor(schoolId);
      }

      match /atividades_avulsas/{atividadeId} {
        allow read: if true;
        allow create, update: if isAdminOrProfessorOrSecretaria(schoolId);
        allow delete: if isAdminOrProfessorOrSecretaria(schoolId);
      }

      match /atividades_avulsas_respostas/{resultadoId} {
        allow read: if isSchoolMember(schoolId);
        allow create: if request.resource.data.keys().hasAll([
            'atividadeId',
            'atividadeTitulo',
            'participanteNome',
            'participanteEmail',
            'acertos',
            'respondidas',
            'totalQuestoes',
            'percentual',
            'nota',
            'valorAtividade',
            'realizadoEm'
          ])
          && request.resource.data.atividadeId is string
          && request.resource.data.atividadeTitulo is string
          && request.resource.data.participanteNome is string
          && request.resource.data.participanteEmail is string
          && request.resource.data.participanteNome.size() >= 3
          && request.resource.data.participanteNome.size() <= 120
          && request.resource.data.participanteEmail.size() <= 160
          && request.resource.data.participanteEmail.matches('^.{1,}@.{1,}\\..{2,}$')
          && request.resource.data.acertos is int
          && request.resource.data.respondidas is int
          && request.resource.data.totalQuestoes is int
          && request.resource.data.percentual is number
          && request.resource.data.nota is number
          && request.resource.data.valorAtividade is number
          && isPublishedPublicAvulsa(schoolId, request.resource.data.atividadeId);
        allow update, delete: if false;
      }

      match /treinamentos_registros/{registroId} {
        allow read: if isAdminOrProfessor(schoolId);
        allow create: if request.resource.data.keys().hasAll([
            'treinamentoId',
            'treinamentoTitulo',
            'participanteNome',
            'sessionId',
            'entradaEm',
            'saidaEm',
            'concluido',
            'concluidoEm',
            'origem'
          ])
          && request.resource.data.treinamentoId is string
          && request.resource.data.treinamentoTitulo is string
          && request.resource.data.participanteNome is string
          && request.resource.data.sessionId is string
          && request.resource.data.origem is string
          && request.resource.data.participanteNome.size() >= 3
          && request.resource.data.participanteNome.size() <= 120
          && request.resource.data.sessionId.size() >= 10
          && request.resource.data.sessionId.size() <= 120
          && request.resource.data.treinamentoId.matches('^(lean|nr20)$')
          && request.resource.data.entradaEm is timestamp
          && request.resource.data.saidaEm == null
          && request.resource.data.concluido is bool
          && request.resource.data.concluido == false
          && request.resource.data.concluidoEm == null;
        allow update: if request.resource.data.sessionId == resource.data.sessionId
          && request.resource.data.participanteNome == resource.data.participanteNome
          && request.resource.data.treinamentoId == resource.data.treinamentoId
          && request.resource.data.treinamentoTitulo == resource.data.treinamentoTitulo
          && request.resource.data.origem == resource.data.origem
          && request.resource.data.entradaEm == resource.data.entradaEm
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'saidaEm',
            'concluido',
            'concluidoEm',
            'ultimaAtualizacaoEm'
          ])
          && (request.resource.data.saidaEm == null || request.resource.data.saidaEm is timestamp)
          && (request.resource.data.concluidoEm == null || request.resource.data.concluidoEm is timestamp)
          && request.resource.data.concluido is bool;
        allow delete: if false;
      }

      match /forum/{forumId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isSchoolMember(schoolId);
      }

      match /forum_salas/{salaId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isSchoolMember(schoolId);
      }

      match /eventos_calendario/{eventoId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isAdminOrProfessorOrSecretaria(schoolId);
      }

      match /presencas/{presencaId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isAdminOrProfessorOrSecretaria(schoolId);
      }

      match /receitas/{receitaId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isAdmin(schoolId) || isSecretaria(schoolId);
      }

      match /despesas/{despesaId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isAdmin(schoolId) || isSecretaria(schoolId);
      }

      match /financeiro_categorias/{categoriaId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isAdmin(schoolId) || isSecretaria(schoolId);
      }

      match /contas_financeiras/{contaId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isAdmin(schoolId) || isSecretaria(schoolId);
      }

      match /metas_financeiras/{metaId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isAdmin(schoolId) || isSecretaria(schoolId);
      }

      match /orcamentos_financeiros/{orcamentoId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isAdmin(schoolId) || isSecretaria(schoolId);
      }

      match /movimentacoes_financeiras/{movimentacaoId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isAdmin(schoolId) || isSecretaria(schoolId);
      }

      match /estoque/{itemId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isAdmin(schoolId) || isSecretaria(schoolId);
      }

      match /estoque_movimentos/{movId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isAdmin(schoolId) || isSecretaria(schoolId);
      }

      match /fornecedores/{fornecedorId} {
        allow read: if isAdmin(schoolId) || isSecretaria(schoolId);
        allow write: if isAdmin(schoolId) || isSecretaria(schoolId);
      }

      match /produtos/{produtoId} {
        allow read: if isAdmin(schoolId) || isSecretaria(schoolId);
        allow write: if isAdmin(schoolId) || isSecretaria(schoolId);
      }

      match /avisos/{avisoId} {
        allow read: if isSchoolMember(schoolId);
        allow create, delete: if isAdminOrProfessor(schoolId);
        allow update: if isAdminOrProfessor(schoolId) ||
          (isSchoolMember(schoolId) && isAvisoLeituraOnlyUpdate());
      }

      match /logs_acesso/{logId} {
        allow read: if isAdmin(schoolId) || isGlobalSuperAdmin();
        allow create: if isSchoolMember(schoolId);
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
